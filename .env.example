# Environment Configuration

# LLM Configuration
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
HERMES_MODEL=hermes-3-llama-3.1-8b

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_INGESTION=hermesmesh-ingestion
KAFKA_TOPIC_WORKERS=hermesmesh-workers

# NATS Configuration
NATS_URL=nats://localhost:4222

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/hermesmesh

# Logging
LOG_LEVEL=INFO
LOG_FILE=hermesmesh.log
